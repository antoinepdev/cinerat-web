---
export interface Props {
  title: string;
  children: any;
  variant?: 'default' | 'highlight';
}
const { title, children, variant = 'default' } = Astro.props;
const extraClass = variant === 'highlight' ? 'border-orange-500/30 bg-orange-500/5' : '';
---
<div class={`update-card p-6 ${extraClass}`}>
  <h3 class="text-xl font-bold text-white flex items-center gap-2">
    {title}
  </h3>
  <div class="mt-2 text-gray-300">
    {children}
  </div>
</div>