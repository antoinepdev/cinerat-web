
---
const base = import.meta.env.BASE_URL || '/cinerat-web';
---

<nav class="fixed w-full z-50 border-b border-white/5 bg-black/80 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
    <!-- Logo (enlace a la raíz del sitio) -->
    <a href={base} class="text-white text-xl font-bold">🎬 <span class="gradient-text">Cineman</span></a>

    <!-- Enlaces de escritorio -->
    <div class="hidden md:flex items-center gap-6 text-sm font-medium">
      <a href={`${base}/#inicio`} class="text-white/70 hover:text-white transition">Inicio</a>
      <a href={`${base}/#problema`} class="text-white/70 hover:text-white transition">Problema</a>
      <a href={`${base}/#caracteristicas`} class="text-white/70 hover:text-white transition">Qué ofrecemos</a>
      <a href={`${base}/#como`} class="text-white/70 hover:text-white transition">Cómo obtenerlo</a>
      <a href={`${base}/#actualizaciones`} class="text-white/70 hover:text-white transition">Actualizaciones</a>
      <a href={`${base}/peliculas/1`} class="text-white/70 hover:text-white transition font-medium border-b-2 border-orange-500/30">Catálogo</a>
    </div>

    <!-- Botón Comprar + Hamburguesa -->
    <div class="flex items-center gap-3">
      <a href={`${base}/#como`} class="btn-primary-sm hidden sm:inline-block">Descargar Pack</a>
      <button id="menu-btn" class="md:hidden text-white/80 hover:text-white focus:outline-none" aria-label="Menú">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="mobile-menu md:hidden bg-black/95 backdrop-blur-md border-b border-white/5 px-4 py-2">
    <div class="flex flex-col space-y-3 py-3 text-sm font-medium">
      <a href={`${base}/#inicio`} class="text-white/80 hover:text-white transition">Inicio</a>
      <a href={`${base}/#problema`} class="text-white/80 hover:text-white transition">Problema</a>
      <a href={`${base}/#caracteristicas`} class="text-white/80 hover:text-white transition">Qué ofrecemos</a>
      <a href={`${base}/#precio`} class="text-white/80 hover:text-white transition">Precio</a>
      <a href={`${base}/#actualizaciones`} class="text-white/80 hover:text-white transition">Actualizaciones</a>
      <a href={`${base}/peliculas/1`} class="text-white/80 hover:text-white transition font-medium">Catálogo</a>
      <hr class="border-white/10" />
      <a href={`${base}/#como`} class="btn-primary-sm block text-center">Descargar Pack</a>
    </div>
  </div>
</nav>