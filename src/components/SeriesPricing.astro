---
import { SERIES_PRICE_TIERS } from '../helpers/seriesPricing.ts';

interface Props {
  seriesLength?: number;
}

const { seriesLength = 0 } = Astro.props;
const base = import.meta.env.BASE_URL || '/cinerat-web';
const telegramUrl = `https://t.me/antoinepdev?text=${encodeURIComponent('Hola Antoine, quiero información sobre el pack de series.')}`;
---

<section id="series" class="py-16 bg-black/90 border-t border-white/5 bg-grid">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-10">
      <div class="inline-block bg-orange-500/20 text-orange-400 text-sm font-bold px-4 py-1 rounded-full mb-4">
        SERVICIO INDEPENDIENTE
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-white">
        Pack de <span class="gradient-text">series</span>
      </h2>
      <p class="text-gray-400 text-lg mt-3 max-w-2xl mx-auto">
        Aquí no descargas un pack cerrado: eliges las {seriesLength} series que te interesen
        y se suman todos los episodios de tu selección.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {SERIES_PRICE_TIERS.map((tier) => (
        <div class="pricing-card p-5 text-center">
          <span class="block text-3xl font-extrabold text-orange-400">{tier.price}</span>
          <span class="block text-sm text-gray-400 mt-2">{tier.range}</span>
        </div>
      ))}
    </div>

    <p class="text-center text-xs text-gray-500 mt-4">
      Precios en USD. Más de 1500 episodios: escríbeme para un presupuesto.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href={`${base}/series/1`} class="btn-primary text-lg">📺 Elegir mis series</a>
      <a href={telegramUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary text-lg">
        💬 Consultar disponibilidad
      </a>
    </div>

    <p class="text-center text-sm text-gray-500 mt-6">
      El pack de películas de $10 es un producto aparte y sigue incluyendo todas las películas del catálogo.
    </p>
  </div>
</section>
