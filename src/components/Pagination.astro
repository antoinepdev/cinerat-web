---
const {prevPage, totalPages, nextPage, page, path = '/peliculas'} = Astro.props
const base = import.meta.env.BASE_URL || '/cinerat-web';
// totalPages debe ser page.lastPage (nº de páginas), nunca page.total (nº de elementos).
const lastPage = Math.max(1, Number(totalPages) || 1);
const current = Math.min(Math.max(1, Number(page) || 1), lastPage);
const WINDOW = 10;
let startPage = 1;
let endPage = Math.min(lastPage, WINDOW);

if (lastPage > WINDOW) {
  startPage = Math.max(1, current - Math.floor(WINDOW / 2));
  endPage = Math.min(lastPage, startPage + WINDOW - 1);
  if (endPage === lastPage) startPage = Math.max(1, endPage - WINDOW + 1);
}

const pages = Array.from({ length: endPage - startPage + 1 }, (_, i) => startPage + i);
---
<div class="flex flex-wrap items-center justify-center gap-2 mt-12">
    {prevPage && (
      <a href={prevPage} class="pagination-btn">← Anterior</a>
    )}
    {!prevPage && (
      <span class="pagination-btn" aria-disabled="true">← Anterior</span>
    )}

    {pages.map((pageNum) => (
      <a
        href={`${base}${path}/${pageNum}`}
        class={`pagination-btn ${pageNum === current ? 'active' : ''}`}
        aria-current={pageNum === current ? 'page' : undefined}
      >
        {pageNum}
      </a>
    ))}
    {nextPage && (
      <a href={nextPage} class="pagination-btn">Siguiente →</a>
    )}
    {!nextPage && (
      <span class="pagination-btn" aria-disabled="true">Siguiente →</span>
    )}
</div>
